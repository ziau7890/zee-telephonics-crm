# Copy to .env.local for development. Never commit real values.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Where the CRM runs (used in invitation and password-reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API). The website uses the same Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for activating accounts, invitations and security logs. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated company email domains allowed to hold CRM accounts, e.g. zeetelephonicsbpo.com
# Leave empty to allow any invited address.
COMPANY_EMAIL_DOMAINS=
